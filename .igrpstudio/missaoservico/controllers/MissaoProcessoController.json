  "description": "etapas dos processos da missao servico",
  "basePath": "api/v1/missao-servico",
  "actions": [
    {
      "actionName": "getProcessoPrestadores",
      "path": "{uuid}/processos/{tipoProcesso}/prestadores",
      "method": "GET",
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "ProcessoPrestadoresResponse",
                "objectType": "dto",
                "collectionType": "none",
                "module": "missaoservico"
              }
            }
          }
        }
      },
      "pathVariables": [
        { "name": "uuid", "type": "string", "isRequired": true },
        { "name": "tipoProcesso", "type": "string", "isRequired": true }
      ]
    },
    {
