          "application/json": {
            "schema": {
              "type": "ProcessoPrestadoresRequest",
              "collectionType": "none",
              "objectType": "dto",
              "module": "missaoservico"
            }
          }
        }
      },
      "responses": {
        "200": {
          "name": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "collectionType": "map"
              }
            }
          }
        }
      },
      "pathVariables": [
        { "name": "uuid", "type": "string", "isRequired": true },
        { "name": "tipoProcesso", "type": "string", "isRequired": true }
      ]
    }
  ],
  "id": "msvctrl03missaoproc"
